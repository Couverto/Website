# ========================
# Server Configuration
# ========================
# Secrets: 32+ random characters each, e.g. `openssl rand -hex 32`. Required, the API refuses to start without them.
SECRET_ACCESS_TOKEN=
API_KEY_SECRET=

# MongoDB credentials (required). Use a URL-safe password, e.g. `openssl rand -hex 24`.
MONGO_ROOT_USERNAME=couverto
MONGO_ROOT_PASSWORD=

# Reverse proxies in front of the API (0 when the API port is published directly)
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:8080
SELF_URL=http://localhost:3001

# ========================
# Email Service (Resend)
# ========================
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# ========================
# Firebase Configuration (Server-side)
# ========================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_BUCKET_NAME=your-project.firebasestorage.app

# ========================
# Stripe Configuration
# ========================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ========================
# Client Configuration (build-time)
# ========================
VITE_API_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_STRIPE_PUBLIC_KEY=your-stripe-public-key


# ========================
# Discord Configuration
# ========================
DISCORD_WEBHOOK_URL=your-discord-webhook
