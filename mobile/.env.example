# Mobile Environment Variables
# Base URL of the Couverto API server (no trailing slash, no /api suffix).
# On a physical device or a simulator, "localhost" refers to the device itself,
# so point this at your machine's LAN IP when testing against a local server,
# e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Base URL of the Couverto web client (used to build shareable links, e.g. collaborator
# invitations, that open in a browser rather than in this app).
EXPO_PUBLIC_WEB_URL=http://localhost:5173
