{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend of couverto",
  "type": "module",
  "author": "villett",
  "scripts": {
    "dev": "nodemon --watch \"src/**/*\" --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "format": "pnpm exec prettier --write './**/*.{js,ts,json,css,md}'"
  },
  "keywords": [],
  "license": "ISC",
  "packageManager": "pnpm@10.6.5",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  }
}
