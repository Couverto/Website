    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "resend": "^6.37.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^20.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
