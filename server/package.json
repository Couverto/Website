    "prettier": "^3.9.10",
    "sinon": "21.0.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
